# Copy to .env.test for local Playwright runs.
# DO NOT commit .env.test — it should be in .gitignore.

# Connection string for the Neon branch used only by E2E tests.
# Create a branch in the Neon dashboard (e.g. named "e2e") and paste its
# pooled connection string here.
E2E_DATABASE_URL=

# Optional: a stable port for the test server. Defaults to 3901.
E2E_PORT=3901

# Optional overrides (all have safe defaults in playwright.config.js):
E2E_JWT_SECRET=e2e-test-secret-do-not-use-in-prod
E2E_ADMIN_EMAIL=admin@test.local
E2E_ADMIN_PASSWORD=test-admin-password-e2e
E2E_STRIPE_WEBHOOK_SECRET=whsec_e2e_test_secret
