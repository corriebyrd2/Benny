# --- Runtime ---
# Railway sets PORT automatically; only override locally.
PORT=3000
NODE_ENV=development

# --- Secrets (REQUIRED in production) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-long-random-string

# --- First admin account (seeded on first boot if no admins exist) ---
ADMIN_EMAIL=owner@bennyandthepets.com
ADMIN_PASSWORD=replace-with-strong-password

# --- CORS ---
# Comma-separated list of origins allowed to call the API from a browser.
# Include both the apex and www Squarespace domains, plus any custom domain.
# Example: https://bennyandthepets.com,https://www.bennyandthepets.com
FRONTEND_ORIGIN=

# --- Persistent storage (Railway Volume) ---
# On Railway, attach a Volume mounted at /data and set these accordingly.
# Leave blank locally to use project-relative paths.
DB_PATH=/data/benny.db
UPLOAD_DIR=/data/uploads

# --- Stripe ---
# From https://dashboard.stripe.com/apikeys (use test keys until go-live).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# From the webhook endpoint you create in the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=
