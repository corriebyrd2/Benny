# --- Runtime ---
# Railway sets PORT automatically; only override locally.
PORT=3000
NODE_ENV=development

# --- Secrets (REQUIRED in production) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-long-random-string

# --- First admin account (seeded on first boot if no admins exist) ---
ADMIN_EMAIL=owner@bennyandthepets.com
ADMIN_PASSWORD=replace-with-strong-password

# --- Database (Neon Postgres) ---
# Copy the "Pooled connection" string from the Neon dashboard. SSL is required.
NEON_DATABASE_URL=

# --- CORS ---
# Optional. Comma-separated list of origins allowed to call the API from a
# browser. Leave blank if the frontend is served by this same app.
FRONTEND_ORIGIN=

# --- Uploads (Railway Volume) ---
# Attach a Volume mounted at /data and set this to /data/uploads in production.
# Not needed when R2 is configured — uploaded files go straight to the bucket.
UPLOAD_DIR=

# --- Cloudflare R2 (object storage for uploaded photos) ---
# Account ID from the Cloudflare dashboard (appears in the R2 URL).
R2_ACCOUNT_ID=
# R2 API token credentials (create under Manage R2 API Tokens).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Name of the R2 bucket.
R2_BUCKET_NAME=benny
# Public URL for the bucket (enable "Public access" on the bucket in Cloudflare).
R2_PUBLIC_URL=

# --- Stripe ---
# From https://dashboard.stripe.com/apikeys (use test keys until go-live).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# From the webhook endpoint you create in the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=

# --- SendGrid (transactional email) ---
# API key from https://app.sendgrid.com/settings/api_keys (Mail Send permission).
SENDGRID_API_KEY=
# Sender email — MUST be verified in SendGrid (Single Sender or Domain Auth).
SENDGRID_FROM_EMAIL=
# Display name (optional).
SENDGRID_FROM_NAME=Benny and the Pets
# Where new-booking / payment-received notifications go. Defaults to ADMIN_EMAIL.
OWNER_NOTIFICATION_EMAIL=

# --- Public URL (used in email links) ---
# e.g. https://bennyandthepets.com
PUBLIC_URL=
